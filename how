    ```
                "name": "MERGER-MultiNodeLocal1l-0",
                "inputs": [
                    {
                        "binding": "timer-publish",
                        "origin": "MRGR\u00012541_221\n\u001F,
                        "description": "timer-MultiNodeL",
                        "subspec": 65536,
                        "lifetime": 4
                    },
                    {
